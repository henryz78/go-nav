{
  "title": "Henry's Nav",
  "name": "Henry's Nav",
  "description": "个人网址导航",
  "keywords": [
    "网址导航站",
    "导航站",
    "网址导航",
    "个人导航"
  ],
  "logo": "",
  "favicon": "",
  "author": "Henry",
  "copyright": "© 2026 Henry",
  "icp": "",
  "beian": "",
  "qrCode": "",
  "qrCodeText": "",
  "footerLinks": [],
  "themeMode": "system",
  "search": {
    "defaultEngine": "local",
    "enableLocalSearch": true,
    "showEngineSelector": true,
    "enableSuggestion": true,
    "enableTabFocus": true,
    "placeholder": "搜索网站或直接按 Enter 通过外部引擎搜索...",
    "engines": [
      {
        "id": "baidu",
        "name": "百度",
        "icon": "/images/baidu.svg",
        "url": "https://www.baidu.com/s?wd={query}"
      },
      {
        "id": "bing",
        "name": "必应",
        "icon": "/images/bing.svg",
        "url": "https://www.bing.com/search?q={query}"
      },
      {
        "id": "google",
        "name": "谷歌",
        "icon": "/images/google.svg",
        "url": "https://www.google.com/search?q={query}"
      }
    ]
  },
  "ads": [],
  "plugins": [],
  "layout": {
    "maxWidth": "1400",
    "showFooter": false,
    "showFooterQrCode": false,
    "showFloatingQrCode": false,
    "showFloatingActions": false,
    "defaultIconPadding": "8",
    "linkTarget": "new"
  },
  "adsAspectRatio": "4/3",
  "homeAdsAspectRatio": "16/9",
  "submission": {
    "enabled": true,
    "showFloatingButton": true,
    "showSidebarButton": true,
    "staticEmail": ""
  },
  "sidebarAdsEnabled": false,
  "homeAdsEnabled": false
}